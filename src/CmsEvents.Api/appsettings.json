{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "CmsEventsPerMinute": 100,
    "QueryPerMinute": 60,
    "AdminActionsPerMinute": 30
  },
  "Processing": {
    "TimeoutSeconds": 60
  }
}

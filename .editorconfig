root = true

# ============================================================
# All files
# ============================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx,vb,vbx}]
indent_size = 4

[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml,md,html,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ============================================================
# C# code style
# ============================================================
[*.cs]
# using organization
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 'this.' qualification
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# language keywords vs. framework type names
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# expression-level preferences
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# var / explicit type
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:none
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

# null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# code block preferences
csharp_prefer_braces = true:warning

# using directive placement
csharp_using_directive_placement = inside_namespace:warning

# file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# analyzer severities (a few common ones)
dotnet_diagnostic.CA1063.severity = warning     # Implement IDisposable correctly
dotnet_diagnostic.CA1848.severity = suggestion  # Use LoggerMessage delegates (nice to have, not blocking)
dotnet_diagnostic.CA2007.severity = none        # ConfigureAwait — not needed in ASP.NET Core
dotnet_diagnostic.CA1859.severity = suggestion  # Concrete types for perf — overly aggressive on IConfiguration/IServiceCollection setup params
dotnet_diagnostic.CA1711.severity = suggestion  # 'Handler'/'Repository'/'Queries' suffix reserved for delegates — false positive in MediatR/CQRS/Strategy idioms

# ============================================================
# XML files
# ============================================================
[*.{xml,config,nuspec,resx,ruleset,vsixmanifest,vsct}]
indent_size = 2

# ============================================================
# Test projects
# ============================================================
# Test methods use the idiomatic Method_Scenario_Expected naming convention
# (e.g., Delete_ForOrphan_ReturnsSkipped). Underscores are intentional and
# widely used in xUnit; suppress CA1707 here without affecting production code.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
